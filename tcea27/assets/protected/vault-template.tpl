<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>Presenter access | TCEA 2027</title><style>*{box-sizing:border-box}body{margin:0;background:#f8f3e5;color:#082759;font:17px/1.6 system-ui,sans-serif;min-height:100vh;display:grid;place-items:center;padding:24px}main{width:min(100%,520px);background:white;padding:35px;border-radius:20px;border-top:7px solid #fcb040;box-shadow:0 15px 45px #08275915}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#28657a}h1{font-size:32px;line-height:1.15;margin:14px 0}label{display:block;font-weight:750;margin-top:23px}input{font:inherit;padding:12px;border:1px solid #8398b2;border-radius:7px;width:100%;margin:8px 0}button{font:inherit;font-weight:750;background:#0a3476;color:#fff;border:0;border-radius:7px;padding:12px 20px;cursor:pointer;min-height:46px}button:disabled{opacity:.6}a{color:#0a3476}a:focus-visible,input:focus-visible,button:focus-visible{outline:3px solid #a35000;outline-offset:4px}.small{font-size:13px;color:#53627a}#vaultStatus{min-height:26px;font-weight:650}noscript{display:block;padding:15px;background:#fff0ce}footer{margin-top:24px;border-top:1px solid #ddd;padding-top:17px}.show{display:flex;gap:8px;align-items:center;font-size:14px;font-weight:500;margin:8px 0 16px}.show input{width:20px;margin:0;height:20px} @media print{form{display:none}}</style></head><body><main><p class="eyebrow">TCEA 2027 · Presenter resources</p><h1>Presenter access</h1><p>Enter the presenter password to open this resource.</p><form id="vaultForm"><label for="vaultPassword">Presenter password</label><input id="vaultPassword" type="password" autocomplete="current-password" required><label class="show"><input id="vaultShow" type="checkbox">Show password</label><label class="show"><input id="vaultRemember" type="checkbox" checked>Remember access on this browser for 30 days</label><button id="vaultOpen" type="submit">Open presenter resource</button><p id="vaultStatus" role="status" aria-live="polite"></p></form><noscript>JavaScript and a browser supporting Web Crypto are required to decrypt this resource. Public attendee activities remain available at the link below.</noscript><p class="small">Decryption happens in your browser. With Remember access selected, this browser keeps a non-exportable unlock key for 30 days. Your password and decrypted notes are not saved. Use “Forget access and lock” to remove remembered access. Uncheck Remember access on a shared device.</p><footer><a href="https://mglearn.github.io/tcea27/">Return to attendee resources</a></footer></main><script id="vaultPayload" type="application/json">__PAYLOAD__</script><script>
(()=>{'use strict';
const payload=JSON.parse(document.getElementById('vaultPayload').textContent),form=document.getElementById('vaultForm'),field=document.getElementById('vaultPassword'),status=document.getElementById('vaultStatus'),button=document.getElementById('vaultOpen'),remember=document.getElementById('vaultRemember');
const bytes=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0)),cookieName='tcea_presenter_access',cookiePath='/tcea27',days=30*86400000;
function token(){return document.cookie.split('; ').find(c=>c.startsWith(cookieName+'='))?.split('=')[1]||'';}
function setCookie(value,age){document.cookie=cookieName+'='+value+'; Path='+cookiePath+'; Max-Age='+age+'; SameSite=Strict'+(location.protocol==='https:'?'; Secure':'');}
function database(){return new Promise((resolve,reject)=>{const r=indexedDB.open('tcea-presenter-access',1);r.onupgradeneeded=()=>r.result.createObjectStore('keys');r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);});}
async function access(mode,value){const db=await database();try{return await new Promise((resolve,reject)=>{const tx=db.transaction('keys',mode==='get'?'readonly':'readwrite'),store=tx.objectStore('keys');let request;if(mode==='get')request=store.get(token());else if(mode==='put')request=store.put(value.record,value.token);else request=store.clear();let result;request.onsuccess=()=>{result=request.result};tx.oncomplete=()=>resolve(result);tx.onerror=()=>reject(tx.error);});}finally{db.close();}}
async function forget(){setCookie('',0);try{await access('clear')}catch{}}
async function save(material){if(location.protocol==='file:')return;const id=crypto.randomUUID();await access('put',{token:id,record:{material,expires:Date.now()+days}});setCookie(id,days/1000);}
async function decrypt(material){const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:bytes(payload.salt),iterations:payload.iterations,hash:'SHA-256'},material,{name:'AES-GCM',length:256},false,['decrypt']);return new TextDecoder().decode(await crypto.subtle.decrypt({name:'AES-GCM',iv:bytes(payload.iv),additionalData:new TextEncoder().encode(payload.context)},key,bytes(payload.ciphertext)));}
function openDocument(html){document.open();document.write(html);document.close();
 const lock=async()=>{await forget();location.reload()};
 // Access controls belong in presenter UI, never over projected slides.
 for(const b of document.querySelectorAll('.deck-lock'))b.remove();
 if(document.querySelector('.deck')){
  const host=document.getElementById('pvClose')?.parentElement||document.querySelector('#help .help-card');
  if(host){const b=document.createElement('button');b.id='presenterForgetAccess';b.type='button';b.textContent='Forget access and lock';b.className=document.getElementById('pvClose')?'pv-btn':'no-print';b.style.cssText='font:inherit;padding:8px 12px;margin-top:10px;cursor:pointer';b.onclick=event=>{event.stopPropagation();lock()};host.appendChild(b);}
 }else for(const b of document.querySelectorAll('button'))if(/lock guide/i.test(b.textContent)){b.textContent='Forget access and lock';b.onclick=lock;}
 window.addEventListener('message',event=>{try{if(location.protocol==='file:')return;if(event.origin!==location.origin||event.data?.type!=='tcea-presenter-request'||event.data.path!==location.pathname||event.source?.opener!==window||event.source.name!=='webdeck-presenter')return;event.source.postMessage({type:'tcea-presenter-document',path:location.pathname,html},location.origin);}catch{}});
}
document.getElementById('vaultShow').addEventListener('change',e=>field.type=e.target.checked?'text':'password');
form.addEventListener('submit',async event=>{event.preventDefault();if(!crypto.subtle){status.textContent='This browser cannot decrypt the resource. Use a current browser over HTTPS, localhost, or the extracted local file.';return;}button.disabled=true;status.textContent='Opening presenter resource…';try{const material=await crypto.subtle.importKey('raw',new TextEncoder().encode(field.value),'PBKDF2',false,['deriveKey']),html=await decrypt(material);field.value='';if(remember.checked){try{await save(material)}catch{ /* Storage unavailable: this tab still opens without persistence. */ }}else await forget();openDocument(html);}catch{status.textContent='That password did not open the resource. Try again.';field.focus();field.select();button.disabled=false;}});
async function restore(){if(!token()||!crypto.subtle)return;status.textContent='Opening with remembered access…';button.disabled=true;try{const saved=await access('get');if(!saved||saved.expires<=Date.now())throw Error('expired');openDocument(await decrypt(saved.material));}catch{await forget();status.textContent='Enter the presenter password to open this resource.';button.disabled=false;}}
if(window.opener&&window.name==='webdeck-presenter'&&location.protocol!=='file:'&&new URLSearchParams(location.search).get('presenter')==='1'){
 const receive=event=>{if(event.source===window.opener&&event.origin===location.origin&&event.data?.type==='tcea-presenter-document'&&event.data.path===location.pathname&&typeof event.data.html==='string'){window.removeEventListener('message',receive);openDocument(event.data.html);}};window.addEventListener('message',receive);window.opener.postMessage({type:'tcea-presenter-request',path:location.pathname},location.origin);
}else restore();
})();
</script></body></html>
